# AlexisHW/amneziawg-web-ui — nginx на сервере панели
#
# Плейсхолдеры:
#   {{PANEL_DOMAIN}}  — ge01awg.rockfactor.ru
#   {{BOT_PUBLIC_IP}} — 217.114.2.219, публичный адрес VPS-1
#   {{ADMIN_WG_NET}}  — 10.10.0.0/24, админский туннель
#
# ОТЛИЧИЕ ОТ PASARGUARD: публичных путей нет вообще.
# Клиенты получают .conf через Telegram и подключаются к WireGuard
# по UDP напрямую — в веб-панель они не обращаются никогда.
# Поэтому панель закрывается вайтлистом целиком.
#
# Панель слушает 127.0.0.1:8080 (контейнер опубликован только на loopback),
# наружу её выставляет этот nginx и только для двух источников.
#
# Basic Auth панели остаётся включённым как второй рубеж: автор
# amneziawg-web-ui прямо пишет в README, что одного Basic Auth мало,
# он подбирается перебором. Вайтлист закрывает именно эту проблему.

limit_req_zone $binary_remote_addr zone=awg_api:10m rate=10r/s;

map $http_upgrade $awg_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream awg_panel {
    server 127.0.0.1:8080;
    keepalive 8;
}

# ── HTTP: только ACME ────────────────────────────────────────────────────────
server {
    listen 80;
    server_name {{PANEL_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    # Ubuntu 24.04 несёт nginx 1.24: http2 указывается в listen.
    listen 443 ssl http2;
    server_name {{PANEL_DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{PANEL_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{PANEL_DOMAIN}}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    server_tokens off;
    client_max_body_size 4m;

    access_log /var/log/nginx/awg-panel.access.log;
    error_log  /var/log/nginx/awg-panel.error.log warn;

    # ── Вайтлист на весь сервер ──────────────────────────────────────────────
    # Порядок важен: nginx применяет первое подходящее правило.
    allow {{BOT_PUBLIC_IP}};
    allow {{ADMIN_WG_NET}};
    deny all;

    location / {
        limit_req zone=awg_api burst=20 nodelay;

        proxy_pass http://awg_panel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Панель отдаёт живые счётчики трафика через Socket.IO
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $awg_connection_upgrade;
        proxy_read_timeout 300s;
    }
}
