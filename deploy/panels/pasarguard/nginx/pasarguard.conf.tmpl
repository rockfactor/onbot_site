# PasarGuard — nginx на панельном сервере
#
# Шаблон. Плейсхолдеры подставляются при установке:
#   {{PANEL_DOMAIN}}   — own.rockfactor.ru
#   {{BOT_PRIVATE_IP}} — 10.16.0.3, приватный адрес VPS-1
#   {{ADMIN_WG_NET}}   — 10.10.0.0/24, админский WireGuard
#
# ГЛАВНАЯ ИДЕЯ: панель нельзя закрыть вайтлистом целиком.
# Ссылки-подписки клиенты открывают со своих устройств из любой точки мира —
# если закрыть /sub/, VLESS перестанет работать у всех покупателей.
# Поэтому доступ разделён по путям, а не по адресу целиком.
#
#   /sub/        публично   — ссылки-подписки клиентов
#   /api/        VPS-1 + WG — бот и админ
#   /dashboard/  только WG  — веб-интерфейс
#   всё прочее   закрыто
#
# Сама панель слушает 127.0.0.1:8000 и наружу не выставлена.

# WebSocket-апгрейд только когда клиент его действительно просит.
# Безусловный `Connection: upgrade` ломает keepalive к панели
# на обычных HTTP-запросах.
map $http_upgrade $pg_connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=pg_sub:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=pg_api:10m rate=10r/s;

upstream pasarguard {
    server 127.0.0.1:8000;
    keepalive 16;
}

# ── HTTP: только ACME и редирект ─────────────────────────────────────────────
server {
    listen 80;
    server_name {{PANEL_DOMAIN}};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ────────────────────────────────────────────────────────────────────
server {
    # Ubuntu 24.04 несёт nginx 1.24: http2 указывается в listen.
    # Отдельная директива `http2 on;` появилась только в 1.25.
    listen 443 ssl http2;
    server_name {{PANEL_DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{PANEL_DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{PANEL_DOMAIN}}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    server_tokens off;
    client_max_body_size 2m;

    access_log /var/log/nginx/pasarguard.access.log;
    error_log  /var/log/nginx/pasarguard.error.log warn;

    # ── Общие параметры проксирования ────────────────────────────────────────
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $pg_connection_upgrade;
    proxy_read_timeout 60s;

    # ── Ссылки-подписки: доступны всем ───────────────────────────────────────
    # Единственный публичный путь. Именно его клиент вставляет
    # в Happ, v2rayNG или Streisand.
    location /sub/ {
        limit_req zone=pg_sub burst=10 nodelay;
        proxy_pass http://pasarguard;
    }

    # ── API: бот с VPS-1 и админ через WireGuard ─────────────────────────────
    # Порядок важен: nginx применяет первое подходящее правило,
    # поэтому allow идут до deny.
    location /api/ {
        allow {{BOT_PRIVATE_IP}};
        allow {{ADMIN_WG_NET}};
        deny all;

        limit_req zone=pg_api burst=20 nodelay;
        proxy_pass http://pasarguard;
    }

    # ── Веб-интерфейс: только через админский WireGuard ──────────────────────
    location /dashboard/ {
        allow {{ADMIN_WG_NET}};
        deny all;
        proxy_pass http://pasarguard;
    }

    # Статика интерфейса лежит рядом и без неё панель не отрисуется
    location /statics/ {
        allow {{ADMIN_WG_NET}};
        deny all;
        proxy_pass http://pasarguard;
    }

    # ── Документация API: закрыта ────────────────────────────────────────────
    # Схема OpenAPI раскрывает полный список эндпоинтов панели.
    # Отключается и флагом docs в .env — здесь дублируем на случай,
    # если флаг будет случайно возвращён при обновлении.
    location ~ ^/(docs|redoc|openapi.json) {
        allow {{ADMIN_WG_NET}};
        deny all;
        proxy_pass http://pasarguard;
    }

    # ── Всё остальное закрыто ────────────────────────────────────────────────
    # Отдаём 404, а не 403: 403 подтверждает сканеру, что путь существует.
    location / {
        return 404;
    }
}
