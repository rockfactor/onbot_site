# Логи nginx для OwnNetBot
#
# Хранение — 400 дней. Требование к платёжной инфраструктуре: логи
# держатся минимум год, последние три месяца — в быстром доступе.
# Поэтому первые 90 файлов не сжимаются (delaycompress + пороговое сжатие
# невозможно в logrotate, поэтому сжимаем всё, кроме самого свежего).

/var/log/nginx/ownnetbot.*.log {
    daily
    rotate 400
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 `cat /var/run/nginx.pid`
    endscript
}
