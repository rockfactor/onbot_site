# ─────────────────────────────────────────────────────────────────────────────
# ДАННЫЕ КЛИЕНТОВ — НИКОГДА НЕ КОММИТИТЬ
# Внимание: git не поддерживает комментарии в конце строки.
# Запись вида «purchases.log  # добавлено» НЕ работает — паттерн
# понимается буквально вместе с текстом после решётки.
# ─────────────────────────────────────────────────────────────────────────────

# Логи (содержат user_id и username покупателей)
*.log
logs/

