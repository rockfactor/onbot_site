# ── Окружение ────────────────────────────────────────────────────────────────
# dev  — локальная разработка, часть проверок отключена
# prod — на сервере; обязательны DB_PASSWORD, WEBHOOK_HOST, WEBHOOK_SECRET
ENV=dev
LOG_LEVEL=INFO

# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_ID=
CHANNEL_USERNAME=own_netbot
SUPPORT_USERNAME=rockfactor
SBER_URL=

# ── PostgreSQL (VPS-2, приватная сеть) ───────────────────────────────────────
DB_HOST=10.0.0.2
DB_PORT=5432
DB_NAME=vpnbot
DB_USER=vpnbot_user
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# ── Webhook (этап 1) ─────────────────────────────────────────────────────────
# WEBHOOK_HOST — только схема + домен, без завершающего слэша
WEBHOOK_HOST=https://your-domain.ru
WEBHOOK_PATH=/webhook/bot
# openssl rand -hex 32
WEBHOOK_SECRET=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# ── JWT (этап 3) ─────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── ЮКасса (этап 2) ──────────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# ── S3 Beget (этап 2) ────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=vpn-configs
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── VPN-панели (этапы 2–4) ───────────────────────────────────────────────────
AWG_API_URL=
AWG_API_KEY=
PASARGUARD_API_URL=
PASARGUARD_API_KEY=
